# Copy this file to .env.local and fill it in. .env.local is kept out of git.
# The Environment section of CLAUDE.md says what each variable does.

# Supabase: Dashboard > Project Settings > API. Public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# For scripts/ only, never app code: the session-pooler connection string from Dashboard > Connect.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-password@your-pooler-host:5432/postgres

# For scripts/upload-archive.mjs and scripts/sync-archive.mjs only, never app code: a secret
# key from Dashboard > Project Settings > API Keys. It bypasses row-level security; the
# scripts use it only for the private stock-archive bucket.
SUPABASE_SECRET_KEY=

# Map tiles. Public by design.
NEXT_PUBLIC_CARTO_API_KEY=

# Where /privacy tells people to send privacy questions and requests.
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional overrides.
# NEXT_PUBLIC_API_URL=https://eraktkosh.mohfw.gov.in/eraktkoshPortal/eraktkosh/
# OSRM_URL=https://your-osrm-server/
# TRUSTED_PROXY_HOPS=1

# Failure drill only, never on a deployed server: down, slow or flaky, and state codes that always fail.
# ERAKTKOSH_SIMULATE=down
# ERAKTKOSH_SIMULATE_STATES=27

# Google sign-in. The app doesn't read these; they go into the Supabase dashboard
# (Authentication > Providers > Google) and are kept here for reference.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
